{
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "prod": ["!{projectRoot}/**/*.spec.tsx"],
    "production": ["default"]
  },
  "targetDefaults": {
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/packages/internal/storybook-utils/**/*"],
      "dependsOn": ["build"],
      "cache": true
    },
    "tsc": {
      "inputs": ["default", "^production", "{workspaceRoot}/tsconfig.json"],
      "dependsOn": ["build"],
      "cache": true
    },
    "eslint": {
      "inputs": ["default", "^production", "{workspaceRoot}/eslint/*.js"],
      "dependsOn": ["build"],
      "cache": true
    },
    "storybook": {
      "dependsOn": ["tsc", "^tsc"],
      "cache": false
    },
    "build:storybook": {
      "inputs": ["default", "^production"],
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/.storybook-static-build"],
      "cache": true
    },
    "build": {
      "inputs": ["prod"],
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "cache": true
    }
  },
  "$schema": "./node_modules/nx/schemas/nx-schema.json"
}

{
  "name": "ft-frontend-saksbehandling",
  "description": "Frontend for saksbehandlingsløsninger i Nav",
  "author": "Nav",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navikt/ft-frontend-saksbehandling.git"
  },
  "scripts": {
    "build": "lerna run build --stream",
    "build:storybook": "lerna run build:storybook --scope @navikt/ft-storybook --stream",
    "test": "lerna run test --stream",
    "test:browser": "lerna run test:browser --stream --concurrency 1",
    "eslint": "lerna run eslint --stream",
    "eslint:fix": "lerna run eslint:fix --stream",
    "prettier:fix": "lerna run prettier:fix --stream",
    "tsc": "lerna run tsc --stream",
    "test:changed": "lerna run test --stream --since origin/main",
    "tsc:changed": "lerna run tsc --stream --since origin/main",
    "eslint:changed": "lerna run eslint --stream --since origin/main",
    "stylelint": "lerna run stylelint --stream",
    "tag": "lerna version --sign-git-tag --no-ignore-scripts",
    "tag:force": "lerna version --sign-git-tag --no-ignore-scripts --force-publish",
    "tag:dry": "lerna version --no-git-tag-version --no-push --no-ignore-scripts",
    "version": "node scripts/replace-workspace-deps.js --peer-only",
    "lerna-changed": "lerna changed",
    "clean": "lerna run clean",
    "prepare": "husky install",
    "storybook": "lerna run storybook --scope @navikt/ft-storybook --stream --",
    "transform-to-semver": "node scripts/replace-workspace-deps.js",
    "transform-to-workspace": "node scripts/replace-workspace-deps.js --restore"
  },
  "devDependencies": {
    "@navikt/aksel-stylelint": "8.23.0",
    "@navikt/ft-config-eslint": "workspace:^",
    "@navikt/ft-frontend-storybook-utils": "workspace:^",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "knip": "6.45.1",
    "lerna": "10.1.2",
    "lint-staged": "17.6.1",
    "prettier": "3.10.1",
    "stylelint": "18.0.0",
    "stylelint-order": "8.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-circular-dependency": "0.6.0",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.1.1",
    "vitest-canvas-mock": "1.2.0"
  },
  "resolutions": {
    "tmp": "^0.2.7",
    "@microsoft/api-extractor/minimatch": "^3.1.4",
    "axios": "1.20.0",
    "brace-expansion": "5.0.12",
    "brace-expansion@npm:^1.1.7": "1.1.21",
    "follow-redirects": "1.16.1",
    "handlebars": "4.7.10",
    "js-yaml": "4.3.2",
    "nx": "23.3.0",
    "undici": "7.29.1",
    "pacote": "^21.5.1",
    "@npmcli/package-json@npm:7.0.2": "^7.0.5",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/internal/*"
    ]
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx,js,jsx}": "eslint --cache --fix",
    "packages/**/*.css": "stylelint --fix",
    "packages/**/*.{ts,tsx,js,jsx, css}": "prettier --write"
  },
  "packageManager": "yarn@4.17.0"
}
